# =============================================================================
# Echoes — environment
#
# Copy to `.env.local` for development. Everything marked REQUIRED must be set
# for the app to run; the rest degrade gracefully (see README → Degradation).
# =============================================================================

# --- Supabase (REQUIRED) -----------------------------------------------------
# `supabase start` prints these for local development.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Bypasses row-level security — never expose it to the browser
# and never prefix it with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# --- Site (REQUIRED in production) -------------------------------------------
# Your deployed address, no trailing slash. Genuinely required: share links,
# the profile preview and the handle picker are built inside client components,
# and Next.js only exposes NEXT_PUBLIC_* variables to the browser. Vercel's own
# VERCEL_PROJECT_PRODUCTION_URL is server-only, so without this every one of
# those links reads "localhost:3000" in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Email: Resend (optional) ------------------------------------------------
# Without a key, notification emails are logged to the console instead of sent.
# Get one free at resend.com/api-keys (3,000 emails a month).
RESEND_API_KEY=

# Leave EMAIL_FROM unset to use onboarding@resend.dev, which Resend provides to
# every account with no domain setup. The catch: it only delivers to the address
# that owns the Resend account. That is fine for your own vault, but nobody else
# who signs up will get email until you verify a domain at resend.com/domains
# and set this to something like "Echoes <hello@yourdomain.com>".
EMAIL_FROM=

# --- Analytics: PostHog (optional) -------------------------------------------
# Without this, every track() call is a no-op.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# --- AI summaries: OpenAI (optional) -----------------------------------------
# Without this, the "Sum this up for me" button is hidden entirely.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- CAPTCHA: Cloudflare Turnstile (optional in dev, expected in production) --
# Without the secret, submissions skip the CAPTCHA check and a warning is
# logged in production. Without the site key, the widget is not rendered.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Security ----------------------------------------------------------------
# Salt for hashing sender IP addresses. Set this to a long random string in
# production; changing it resets rate-limit history and abuse fingerprints.
IP_HASH_SALT=

# --- Scheduled jobs ----------------------------------------------------------
# Shared secret for /api/cron/deliver and the Supabase edge functions.
# Vercel Cron sends it automatically as `Authorization: Bearer $CRON_SECRET`.
CRON_SECRET=
TRASH_RETENTION_DAYS=30
